{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/zsh -lc 'scripts/bin/harness-cli trace --help'","aggregated_output":"Record an agent execution trace\n\nUsage: harness-cli trace [OPTIONS] --summary <SUMMARY>\n\nOptions:\n      --summary <SUMMARY>        \n      --intake <INTAKE>          \n      --story <STORY>            \n      --agent <AGENT>            \n      --outcome <OUTCOME>        \n      --duration <DURATION>      \n      --tokens <TOKENS>          \n      --friction <FRICTION>      \n      --actions <ACTIONS>        \n      --read <FILES_READ>        \n      --changed <FILES_CHANGED>  \n      --decisions <DECISIONS>    \n      --errors <ERRORS>          \n      --notes <NOTES>            \n  -h, --help                     Print help\n","exit_code":0,"status":"completed"}}
