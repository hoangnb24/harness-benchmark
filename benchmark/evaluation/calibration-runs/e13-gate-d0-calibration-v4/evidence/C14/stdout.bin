{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc 'scripts/bin/harness-cli intake --help'","aggregated_output":"Record a feature intake classification\n\nUsage: harness-cli intake [OPTIONS] --type <INPUT_TYPE> --summary <SUMMARY> --lane <tiny|normal|high-risk>\n\nOptions:\n      --type <INPUT_TYPE>             \n      --summary <SUMMARY>             \n      --lane <tiny|normal|high-risk>  \n      --flags <FLAGS>                 \n      --docs <DOCS>                   \n      --story <STORY>                 \n      --notes <NOTES>                 \n  -h, --help                          Print help\n\nAccepted lanes: tiny, normal, high-risk. Use tiny instead of low.\n","exit_code":0,"status":"completed"}}
