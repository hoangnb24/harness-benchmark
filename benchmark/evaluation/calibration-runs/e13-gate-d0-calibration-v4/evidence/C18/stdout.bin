{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,240p' harness-project-map.json\"","aggregated_output":"{\n  \"authority\": \"AGENTS.md\",\n  \"currentBehavior\": [\n    \"src\",\n    \"package.json\"\n  ],\n  \"decisions\": [\n    \"docs/decisions\"\n  ],\n  \"intendedTruth\": [\n    \"PRODUCT_SPEC.md\",\n    \"README.md\"\n  ],\n  \"proof\": [\n    \"npm run build\",\n    \"npm test\"\n  ],\n  \"runtime\": {\n    \"boot\": \"npm run dev\",\n    \"exercise\": \"npm test\",\n    \"observe\": \"application stdout/stderr\",\n    \"reset\": \"restore the immutable task fixture\"\n  },\n  \"schemaVersion\": 1,\n  \"workOwner\": \"current task prompt\"\n}\n","exit_code":0,"status":"completed"}}
