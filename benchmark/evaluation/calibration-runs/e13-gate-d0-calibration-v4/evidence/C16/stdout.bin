{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,240p' scripts/check-harness-map.mjs\nsed -n '1,240p' test/probe.mjs\nls -la\nls -la \\\"\"'$EVALUATION_SUBMISSION\"\nif [ -e \"$EVALUATION_SUBMISSION/proof.md\" ]; then sed -n '\"'1,240p' \\\"\"'$EVALUATION_SUBMISSION/proof.md\"; fi'","aggregated_output":"#!/usr/bin/env node\nimport { access, readFile, readdir } from 'node:fs/promises';\n\nconst map = JSON.parse(await readFile('harness-project-map.json', 'utf8'));\nif (map.schemaVersion !== 1) throw new Error('unsupported project-map schema');\nfor (const key of ['authority', 'intendedTruth', 'currentBehavior', 'runtime', 'proof']) {\n  if (!map[key]) throw new Error(`missing project-map field: ${key}`);\n}\nfor (const item of [map.authority, ...map.intendedTruth, ...map.currentBehavior]) await access(item);\nconst packageJson = JSON.parse(await readFile('package.json', 'utf8'));\nfor (const command of [...Object.values(map.runtime), ...map.proof]) {\n  if (!command.startsWith('npm run ')) continue;\n  const name = command.slice('npm run '.length).split(/\\s+/)[0];\n  if (!packageJson.scripts?.[name]) throw new Error(`missing package script: ${name}`);\n}\ntry {\n  const modules = (await readdir('.harness/modules')).filter((name) => name.endsWith('.md'));\n  if (modules.length === 0) throw new Error('module directory exists but is empty');\n} catch (error) {\n  if (error.code !== 'ENOENT') throw error;\n}\nconsole.log('Harness project map valid.');\nimport assert from 'node:assert/strict';\nimport { readFile } from 'node:fs/promises';\nimport { spawnSync } from 'node:child_process';\nconst script=await readFile(new URL('../scripts/validate.sh',import.meta.url),'utf8');\nassert.ok(script.indexOf('node test/unit.mjs') < script.indexOf('sh scripts/check-local.sh'));\nconst result=spawnSync('/bin/sh',['scripts/validate.sh'],{encoding:'utf8'});\nassert.equal(result.status,0,result.stderr);\nassert.match(result.stdout,/unit-pass/);\nassert.match(result.stdout,/local-pass/);\nconsole.log('merge-pass');\ntotal 32\ndrwxr-xr-x@ 10 themrb  staff  320 Jul 15 11:26 .\ndrwx------@  7 themrb  staff  224 Jul 15 11:26 ..\ndrwxr-xr-x@ 12 themrb  staff  384 Jul 15 11:26 .git\n-rw-r--r--@  1 themrb  staff  632 Jul 15 11:26 AGENTS.md\n-rw-r--r--@  1 themrb  staff  733 Jul 15 11:26 HARNESS.md\n-rw-r--r--@  1 themrb  staff  171 Jul 15 11:26 LOCAL_PATCH.md\ndrwxr-xr-x@  3 themrb  staff   96 Jul 15 11:26 config\n-rw-r--r--@  1 themrb  staff  480 Jul 15 11:26 harness-project-map.json\ndrwxr-xr-x@  5 themrb  staff  160 Jul 15 11:26 scripts\ndrwxr-xr-x@  4 themrb  staff  128 Jul 15 11:26 test\ntotal 0\ndrwxr-xr-x@ 2 themrb  staff   64 Jul 15 11:26 .\ndrwx------@ 7 themrb  staff  224 Jul 15 11:26 ..\n","exit_code":0,"status":"completed"}}
