{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,120p' LOCAL_PATCH.md && find test config -maxdepth 2 -type f -print -exec sed -n '1,120p' {} \\\\;\"","aggregated_output":"# Local Patch\n\nThis pre-existing uncommitted owner note is correct. Keep scripts/check-local.sh byte-for-byte and invoke it from scripts/validate.sh after the unit probe.\ntest/probe.mjs\nimport assert from 'node:assert/strict';\nimport { readFile } from 'node:fs/promises';\nimport { spawnSync } from 'node:child_process';\nconst script=await readFile(new URL('../scripts/validate.sh',import.meta.url),'utf8');\nassert.ok(script.indexOf('node test/unit.mjs') < script.indexOf('sh scripts/check-local.sh'));\nconst result=spawnSync('/bin/sh',['scripts/validate.sh'],{encoding:'utf8'});\nassert.equal(result.status,0,result.stderr);\nassert.match(result.stdout,/unit-pass/);\nassert.match(result.stdout,/local-pass/);\nconsole.log('merge-pass');\ntest/unit.mjs\nconsole.log('unit-pass');\nconfig/local.json\n{\"enabled\":true}\n","exit_code":0,"status":"completed"}}
